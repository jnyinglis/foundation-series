{
  "name": "foundation-series",
  "version": "0.1.0",
  "description": "An Elite-style interplanetary exploration game set in Isaac Asimov's Foundation universe.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "voice": "tsx scripts/voice.ts",
    "storyboard": "tsx scripts/storyboard.ts",
    "portraits": "tsx scripts/portraits.ts",
    "characters": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/characters.py --",
    "scene:library": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/library.py -- public/scenes",
    "scene:sacratorium": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/sacratorium.py -- public/scenes",
    "scene:terrace": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/terrace.py -- public/scenes",
    "scene:vault": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/vault.py -- public/scenes",
    "scene:ruins": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/ruins.py -- public/scenes",
    "scene:estate": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/estate.py -- public/scenes",
    "scene:village": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/village.py -- public/scenes",
    "scene:moon": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/moon.py -- public/scenes",
    "scene:archive": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/archive.py -- public/scenes",
    "scene:longhouse": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/longhouse.py -- public/scenes",
    "scene:timevault": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/timevault.py -- public/scenes",
    "scene:salon": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/salon.py -- public/scenes",
    "scene:cantina": "/Applications/Blender.app/Contents/MacOS/Blender -b --python blender/cantina.py -- public/scenes",
    "connectivity": "tsx scripts/connectivity.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
